[Unit]
Description=Waste Wizard Vite app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jianfjin
Group=jianfjin
WorkingDirectory=/home/jianfjin/projects/waste_wizard
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3001
ExecStartPre=/bin/bash -lc 'test -d dist || npm run build'
ExecStart=/bin/bash -lc 'npm run preview -- --host ${HOST} --port ${PORT} --strictPort'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
